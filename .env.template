# Copy this file to .env and fill in your values:
#   cp .env.template .env
#
# After installing requirements, also install Playwright browsers:
#   pip install -r requirements.txt
#   python -m playwright install chromium

# --- API Configuration ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
HARNESS_MODEL=gpt-4o

# --- Workspace ---
HARNESS_WORKSPACE=./workspace

# --- Harness Tuning (optional) ---
# MAX_HARNESS_ROUNDS=5
# PASS_THRESHOLD=7.0
# COMPRESS_THRESHOLD=80000
# RESET_THRESHOLD=150000
# MAX_AGENT_ITERATIONS=60

# --- Memory (optional) ---
# STATE_CONTEXT_MAX_CHARS=1500
# PROJECT_CONTEXT_MAX_CHARS=2000
# LONG_TERM_PREFS_MAX_CHARS=800
# LONG_TERM_MEMORY_DIR=           # default: ~/.harness/memory

# --- Compression (optional) ---
# OBSERVATION_MAX_CHARS=8000
# TRACE_KEEP_RECENT=8
# TRACE_SUMMARY_MAX_CHARS=4000
# COMPRESS_THRESHOLD=80000        # rules-based trace compression
# RESET_THRESHOLD=150000          # handoff.md + fresh context
